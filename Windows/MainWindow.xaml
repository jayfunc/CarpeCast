<Window
    x:Class="CarpeCast.MainWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:local="using:CarpeCast"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:tb="using:H.NotifyIcon"
    xmlns:tk="using:CommunityToolkit.WinUI.Controls"
    Title="CarpeCast"
    mc:Ignorable="d">

    <Window.SystemBackdrop>
        <MicaBackdrop />
    </Window.SystemBackdrop>

    <Grid>
        <Grid
            x:Name="AppTitleBar"
            Height="40"
            VerticalAlignment="Top"
            Background="Transparent"
            Canvas.ZIndex="10">
            <StackPanel
                Margin="16,0,0,0"
                VerticalAlignment="Center"
                Orientation="Horizontal">
                <Image
                    Width="16"
                    Height="16"
                    Margin="0,0,12,0"
                    Source="/Assets/AppIcon.ico" />
                <TextBlock
                    VerticalAlignment="Center"
                    FontSize="12"
                    Text="CarpeCast" />
            </StackPanel>
        </Grid>

        <tb:TaskbarIcon
            x:Name="TrayIcon"
            ContextMenuMode="SecondWindow"
            IconSource="/Assets/AppIcon.ico"
            ToolTipText="CarpeCast">
            <tb:TaskbarIcon.ContextFlyout>
                <MenuFlyout>
                    <MenuFlyoutItem
                        x:Uid="TrayShowPlayer"
                        Click="ShowLogs_Click"
                        Text="Show Player" />
                    <MenuFlyoutItem
                        x:Uid="TrayExit"
                        Click="Exit_Click"
                        Text="Exit" />
                </MenuFlyout>
            </tb:TaskbarIcon.ContextFlyout>
        </tb:TaskbarIcon>

        <NavigationView
            x:Name="NavView"
            Margin="0,32,0,0"
            IsBackButtonVisible="Collapsed"
            ItemInvoked="NavView_ItemInvoked"
            Loaded="NavView_Loaded"
            PaneDisplayMode="Left">
            <NavigationView.MenuItems>
                <NavigationViewItem
                    x:Uid="NavPlayer"
                    Content="Player"
                    Icon="Play"
                    Tag="Player" />
                <NavigationViewItem
                    x:Uid="NavDevices"
                    Content="Devices"
                    Icon="CellPhone"
                    Tag="Devices" />
            </NavigationView.MenuItems>

            <Frame x:Name="ContentFrame" />
        </NavigationView>
    </Grid>
</Window>
