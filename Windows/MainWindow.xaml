<Window
    x:Class="WindowsMediaReceiver.MainWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:local="using:WindowsMediaReceiver"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:tb="using:H.NotifyIcon"
    xmlns:tk="using:CommunityToolkit.WinUI.Controls"
    Title="CarpeCast"
    mc:Ignorable="d">

    <Window.SystemBackdrop>
        <MicaBackdrop />
    </Window.SystemBackdrop>

    <Grid>
        <Grid x:Name="AppTitleBar" Height="40" VerticalAlignment="Top" Background="Transparent" Canvas.ZIndex="10">
            <StackPanel Orientation="Horizontal" VerticalAlignment="Center" Margin="16,0,0,0">
                <Image Source="/Assets/AppIcon.ico" Width="16" Height="16" Margin="0,0,12,0" />
                <TextBlock Text="CarpeCast" FontSize="12" VerticalAlignment="Center"/>
            </StackPanel>
        </Grid>

        <tb:TaskbarIcon
            x:Name="TrayIcon"
            IconSource="/Assets/AppIcon.ico"
            ToolTipText="CarpeCast">
            <tb:TaskbarIcon.ContextFlyout>
                <MenuFlyout>
                    <MenuFlyoutItem x:Uid="TrayShowPlayer" Click="ShowLogs_Click" Text="Show Player" />
                    <MenuFlyoutItem x:Uid="TrayExit" Click="Exit_Click" Text="Exit" />
                </MenuFlyout>
            </tb:TaskbarIcon.ContextFlyout>
        </tb:TaskbarIcon>

        <NavigationView x:Name="NavView" PaneDisplayMode="Left" IsBackButtonVisible="Collapsed" ItemInvoked="NavView_ItemInvoked" Loaded="NavView_Loaded" Margin="0,40,0,0">
            <NavigationView.MenuItems>
                <NavigationViewItem Tag="Player" Icon="Play" x:Uid="NavPlayer" Content="Player" />
                <NavigationViewItem Tag="Devices" Icon="CellPhone" x:Uid="NavDevices" Content="Devices" />
            </NavigationView.MenuItems>

            <Frame x:Name="ContentFrame" Padding="24" />
        </NavigationView>
    </Grid>
</Window>
