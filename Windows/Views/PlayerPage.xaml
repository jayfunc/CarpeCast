<Page
    x:Class="WindowsMediaReceiver.Views.PlayerPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:viewmodels="using:WindowsMediaReceiver.ViewModels"
    mc:Ignorable="d"
    Background="Transparent">

    <Grid>
        <StackPanel
            HorizontalAlignment="Stretch"
            VerticalAlignment="Center"
            Orientation="Vertical"
            Spacing="8">
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" Spacing="8" Visibility="{x:Bind ViewModel.WaitingVisibility, Mode=OneWay}">
                <FontIcon Glyph="&#xE7F4;" FontSize="14" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                <TextBlock Text="Waiting for connection..." Foreground="{ThemeResource TextFillColorSecondaryBrush}" Style="{ThemeResource CaptionTextBlockStyle}" />
            </StackPanel>

            <TextBlock
                HorizontalAlignment="Center"
                FontWeight="SemiBold"
                Style="{ThemeResource TitleTextBlockStyle}"
                Text="{x:Bind ViewModel.Media.Title, Mode=OneWay}"
                TextTrimming="CharacterEllipsis"
                TextWrapping="NoWrap" />
            <TextBlock
                HorizontalAlignment="Center"
                Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                Style="{ThemeResource BodyTextBlockStyle}"
                Text="{x:Bind ViewModel.Media.Artist, Mode=OneWay}"
                TextTrimming="CharacterEllipsis"
                TextWrapping="NoWrap" />
            <TextBlock
                HorizontalAlignment="Center"
                Foreground="{ThemeResource TextFillColorTertiaryBrush}"
                Style="{ThemeResource CaptionTextBlockStyle}"
                Text="{x:Bind ViewModel.Media.Album, Mode=OneWay}"
                TextTrimming="CharacterEllipsis"
                TextWrapping="NoWrap" />

            <ProgressBar
                Margin="0,16,0,0"
                HorizontalAlignment="Stretch"
                Maximum="{x:Bind ViewModel.Media.Duration, Mode=OneWay}"
                Value="{x:Bind ViewModel.Media.Position, Mode=OneWay}" />

            <Grid Margin="0,4,0,0">
                <TextBlock
                    HorizontalAlignment="Left"
                    Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                    Style="{ThemeResource CaptionTextBlockStyle}"
                    Text="{x:Bind ViewModel.FormattedPosition, Mode=OneWay}" />
                <TextBlock
                    HorizontalAlignment="Right"
                    Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                    Style="{ThemeResource CaptionTextBlockStyle}"
                    Text="{x:Bind ViewModel.FormattedDuration, Mode=OneWay}" />
            </Grid>

            <StackPanel
                Margin="0,16,0,0"
                HorizontalAlignment="Center"
                Orientation="Horizontal"
                Spacing="16">
                <Button
                    Width="48"
                    Height="48"
                    Command="{x:Bind ViewModel.PreviousCommand}"
                    CornerRadius="24">
                    <FontIcon FontFamily="Segoe Fluent Icons" Glyph="&#xE892;" />
                </Button>
                <Button
                    Width="64"
                    Height="64"
                    Command="{x:Bind ViewModel.PlayPauseCommand}"
                    CornerRadius="32"
                    Style="{ThemeResource AccentButtonStyle}">
                    <FontIcon
                        FontFamily="Segoe Fluent Icons"
                        FontSize="24"
                        Glyph="{x:Bind ViewModel.PlayPauseIcon, Mode=OneWay}" />
                </Button>
                <Button
                    Width="48"
                    Height="48"
                    Command="{x:Bind ViewModel.NextCommand}"
                    CornerRadius="24">
                    <FontIcon FontFamily="Segoe Fluent Icons" Glyph="&#xE893;" />
                </Button>
            </StackPanel>
        </StackPanel>
    </Grid>
</Page>
