<Page
    x:Class="CarpeCast.Views.PlayerPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:models="using:CarpeCast.Models"
    Background="Transparent"
    mc:Ignorable="d">

    <Grid>
        <StackPanel MaxWidth="440" VerticalAlignment="Center" HorizontalAlignment="Center" Spacing="24" Margin="24">
            
            <ComboBox
                x:Uid="SelectDevice"
                HorizontalAlignment="Center"
                ItemsSource="{x:Bind ViewModel.DevicesVM.Devices, Mode=OneWay}"
                SelectedItem="{x:Bind ViewModel.DevicesVM.ActiveDevice, Mode=TwoWay}"
                PlaceholderText="Select Device"
                BorderThickness="0"
                Background="Transparent"
                MinWidth="200">
                <ComboBox.ItemTemplate>
                    <DataTemplate x:DataType="models:DeviceModel">
                        <TextBlock Text="{x:Bind DeviceName}" />
                    </DataTemplate>
                </ComboBox.ItemTemplate>
            </ComboBox>

            <!-- Album Art Container -->
            <Border Width="320" Height="320" CornerRadius="16" BorderBrush="{ThemeResource SurfaceStrokeColorDefault}" BorderThickness="1" Background="{ThemeResource LayerFillColorDefaultBrush}" HorizontalAlignment="Center">
                <Grid>
                    <FontIcon FontFamily="Segoe Fluent Icons" Glyph="&#xE8D6;" FontSize="64" Foreground="{ThemeResource TextFillColorTertiaryBrush}" />
                    <Image Source="{x:Bind ViewModel.AlbumArtImage, Mode=OneWay}" Stretch="UniformToFill" />
                </Grid>
            </Border>

            <StackPanel Spacing="16" Margin="16,0,16,0">
                <!-- Text -->
                <StackPanel Spacing="4">
                    <TextBlock Text="{x:Bind ViewModel.DisplayTitle, Mode=OneWay}" Style="{ThemeResource TitleTextBlockStyle}" FontWeight="Bold" TextTrimming="CharacterEllipsis" MaxLines="1" HorizontalAlignment="Left" />
                    <TextBlock Text="{x:Bind ViewModel.DisplayArtist, Mode=OneWay}" Style="{ThemeResource BodyTextBlockStyle}" Foreground="{ThemeResource TextFillColorSecondaryBrush}" TextTrimming="CharacterEllipsis" MaxLines="1" HorizontalAlignment="Left" />
                    <TextBlock Text="{x:Bind ViewModel.DisplayAlbum, Mode=OneWay}" Style="{ThemeResource CaptionTextBlockStyle}" Foreground="{ThemeResource TextFillColorTertiaryBrush}" TextTrimming="CharacterEllipsis" MaxLines="1" HorizontalAlignment="Left" />
                </StackPanel>

                <!-- Progress -->
                <StackPanel Spacing="8">
                    <ProgressBar Maximum="{x:Bind ViewModel.CurrentDuration, Mode=OneWay}" Value="{x:Bind ViewModel.CurrentPosition, Mode=OneWay}" HorizontalAlignment="Stretch" />
                    <Grid>
                        <TextBlock HorizontalAlignment="Left" Text="{x:Bind ViewModel.FormattedPosition, Mode=OneWay}" Style="{ThemeResource CaptionTextBlockStyle}" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                        <TextBlock HorizontalAlignment="Right" Text="{x:Bind ViewModel.FormattedDuration, Mode=OneWay}" Style="{ThemeResource CaptionTextBlockStyle}" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                    </Grid>
                </StackPanel>

                <!-- Controls -->
                <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" Spacing="24">
                    <Button Width="48" Height="48" CornerRadius="24" Command="{x:Bind ViewModel.PreviousCommand}" Background="Transparent" BorderThickness="0">
                        <FontIcon FontFamily="Segoe Fluent Icons" Glyph="&#xE892;" FontSize="18" />
                    </Button>
                    <Button Width="64" Height="64" CornerRadius="32" Command="{x:Bind ViewModel.PlayPauseCommand}" Style="{ThemeResource AccentButtonStyle}">
                        <FontIcon FontFamily="Segoe Fluent Icons" Glyph="{x:Bind ViewModel.PlayPauseIcon, Mode=OneWay}" FontSize="24" />
                    </Button>
                    <Button Width="48" Height="48" CornerRadius="24" Command="{x:Bind ViewModel.NextCommand}" Background="Transparent" BorderThickness="0">
                        <FontIcon FontFamily="Segoe Fluent Icons" Glyph="&#xE893;" FontSize="18" />
                    </Button>
                </StackPanel>
            </StackPanel>
        </StackPanel>
    </Grid>
</Page>
