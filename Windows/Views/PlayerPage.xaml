<Page
    x:Class="CarpeCast.Views.PlayerPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:models="using:CarpeCast.Models"
    Background="Transparent"
    mc:Ignorable="d">

    <Grid>
        <!--  Background Immersive Image  -->
        <Image
            HorizontalAlignment="Stretch"
            VerticalAlignment="Top"
            Source="{x:Bind ViewModel.AlbumArtImage, Mode=OneWay}"
            Stretch="UniformToFill" />

        <!--  Fade out gradient overlay  -->
        <Border HorizontalAlignment="Stretch" VerticalAlignment="Stretch">
            <Border.Background>
                <LinearGradientBrush StartPoint="0,0" EndPoint="0,1">
                    <GradientStop Offset="0.0" Color="#00000000" />
                    <GradientStop Offset="0.3" Color="#00000000" />
                    <GradientStop Offset="0.8" Color="{ThemeResource LayerFillColorDefault}" />
                    <GradientStop Offset="1.0" Color="{ThemeResource LayerFillColorDefault}" />
                </LinearGradientBrush>
            </Border.Background>
        </Border>

        <!--  Placeholder Icon  -->
        <FontIcon
            Margin="0,100,0,0"
            VerticalAlignment="Top"
            FontFamily="Segoe Fluent Icons"
            FontSize="120"
            Foreground="{ThemeResource TextFillColorTertiaryBrush}"
            Glyph="&#xE8D6;"
            Visibility="{x:Bind ViewModel.NoAlbumArtVisibility, Mode=OneWay}" />

        <!--  Foreground Content  -->
        <Grid Padding="24">
            <Grid.RowDefinitions>
                <RowDefinition Height="*" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>

            <!--  Info & Controls  -->
            <StackPanel
                Grid.Row="1"
                MaxWidth="560"
                HorizontalAlignment="Stretch"
                VerticalAlignment="Bottom"
                Spacing="16">

                <!--  Device Selector  -->
                <ComboBox
                    x:Uid="SelectDevice"
                    MinWidth="160"
                    HorizontalAlignment="Left"
                    ItemsSource="{x:Bind ViewModel.DevicesVM.Devices, Mode=OneWay}"
                    PlaceholderText="Select Device"
                    SelectedItem="{x:Bind ViewModel.DevicesVM.ActiveDevice, Mode=TwoWay}">
                    <ComboBox.ItemTemplate>
                        <DataTemplate x:DataType="models:DeviceModel">
                            <TextBlock FontWeight="SemiBold" Text="{x:Bind DeviceName}" />
                        </DataTemplate>
                    </ComboBox.ItemTemplate>
                </ComboBox>

                <!--  Text  -->
                <StackPanel Spacing="4">
                    <TextBlock
                        HorizontalAlignment="Left"
                        FontWeight="Bold"
                        MaxLines="1"
                        Style="{ThemeResource TitleTextBlockStyle}"
                        Text="{x:Bind ViewModel.DisplayTitle, Mode=OneWay}"
                        TextTrimming="CharacterEllipsis" />
                    <TextBlock
                        HorizontalAlignment="Left"
                        Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                        MaxLines="1"
                        Style="{ThemeResource BodyTextBlockStyle}"
                        Text="{x:Bind ViewModel.DisplayArtist, Mode=OneWay}"
                        TextTrimming="CharacterEllipsis" />
                    <TextBlock
                        HorizontalAlignment="Left"
                        Foreground="{ThemeResource TextFillColorTertiaryBrush}"
                        MaxLines="1"
                        Style="{ThemeResource CaptionTextBlockStyle}"
                        Text="{x:Bind ViewModel.DisplayAlbum, Mode=OneWay}"
                        TextTrimming="CharacterEllipsis" />
                </StackPanel>

                <!--  Progress  -->
                <StackPanel Spacing="8">
                    <ProgressBar
                        HorizontalAlignment="Stretch"
                        Maximum="{x:Bind ViewModel.CurrentDuration, Mode=OneWay}"
                        Value="{x:Bind ViewModel.CurrentPosition, Mode=OneWay}" />
                    <Grid>
                        <TextBlock
                            HorizontalAlignment="Left"
                            Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                            Style="{ThemeResource CaptionTextBlockStyle}"
                            Text="{x:Bind ViewModel.FormattedPosition, Mode=OneWay}" />
                        <TextBlock
                            HorizontalAlignment="Right"
                            Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                            Style="{ThemeResource CaptionTextBlockStyle}"
                            Text="{x:Bind ViewModel.FormattedDuration, Mode=OneWay}" />
                    </Grid>
                </StackPanel>

                <!--  Controls  -->
                <StackPanel
                    HorizontalAlignment="Center"
                    Orientation="Horizontal"
                    Spacing="24">
                    <Button
                        Width="48"
                        Height="48"
                        Background="Transparent"
                        BorderThickness="0"
                        Command="{x:Bind ViewModel.PreviousCommand}"
                        CornerRadius="24">
                        <FontIcon
                            FontFamily="Segoe Fluent Icons"
                            FontSize="18"
                            Glyph="&#xE892;" />
                    </Button>
                    <Button
                        Width="64"
                        Height="64"
                        Command="{x:Bind ViewModel.PlayPauseCommand}"
                        CornerRadius="32"
                        Style="{ThemeResource AccentButtonStyle}">
                        <FontIcon
                            FontFamily="Segoe Fluent Icons"
                            FontSize="24"
                            Glyph="{x:Bind ViewModel.PlayPauseIcon, Mode=OneWay}" />
                    </Button>
                    <Button
                        Width="48"
                        Height="48"
                        Background="Transparent"
                        BorderThickness="0"
                        Command="{x:Bind ViewModel.NextCommand}"
                        CornerRadius="24">
                        <FontIcon
                            FontFamily="Segoe Fluent Icons"
                            FontSize="18"
                            Glyph="&#xE893;" />
                    </Button>
                </StackPanel>
            </StackPanel>
        </Grid>
    </Grid>
</Page>
