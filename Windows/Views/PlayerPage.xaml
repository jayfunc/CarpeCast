<Page
    x:Class="CarpeCast.Views.PlayerPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:models="using:CarpeCast.Models"
    Background="Transparent"
    mc:Ignorable="d">

    <Grid>
        <ComboBox
            x:Uid="SelectDevice"
            Margin="36"
            HorizontalAlignment="Right"
            VerticalAlignment="Top"
            ItemsSource="{x:Bind ViewModel.DevicesVM.Devices, Mode=OneWay}"
            SelectedItem="{x:Bind ViewModel.DevicesVM.ActiveDevice, Mode=TwoWay}"
            PlaceholderText="Select Device"
            Width="200">
            <ComboBox.ItemTemplate>
                <DataTemplate x:DataType="models:DeviceModel">
                    <TextBlock Text="{x:Bind DeviceName}" />
                </DataTemplate>
            </ComboBox.ItemTemplate>
        </ComboBox>

        <StackPanel
            Margin="36"
            HorizontalAlignment="Stretch"
            VerticalAlignment="Center"
            Orientation="Vertical"
            Spacing="8">

            <Border
                Width="200"
                Height="200"
                Margin="0,0,0,16"
                HorizontalAlignment="Center"
                CornerRadius="16">
                <Border.Background>
                    <SolidColorBrush Color="{ThemeResource SurfaceStrokeColorDefault}" />
                </Border.Background>
                <Image
                    Source="{x:Bind ViewModel.AlbumArtImage, Mode=OneWay}"
                    Stretch="UniformToFill" />
            </Border>

            <TextBlock
                HorizontalAlignment="Center"
                FontWeight="SemiBold"
                Style="{ThemeResource TitleTextBlockStyle}"
                Text="{x:Bind ViewModel.DisplayTitle, Mode=OneWay}"
                TextTrimming="CharacterEllipsis"
                TextWrapping="NoWrap" />
            <TextBlock
                HorizontalAlignment="Center"
                Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                Style="{ThemeResource BodyTextBlockStyle}"
                Text="{x:Bind ViewModel.DisplayArtist, Mode=OneWay}"
                TextTrimming="CharacterEllipsis"
                TextWrapping="NoWrap" />
            <TextBlock
                HorizontalAlignment="Center"
                Foreground="{ThemeResource TextFillColorTertiaryBrush}"
                Style="{ThemeResource CaptionTextBlockStyle}"
                Text="{x:Bind ViewModel.DisplayAlbum, Mode=OneWay}"
                TextTrimming="CharacterEllipsis"
                TextWrapping="NoWrap" />

            <ProgressBar
                Margin="0,16,0,0"
                HorizontalAlignment="Stretch"
                Maximum="{x:Bind ViewModel.CurrentDuration, Mode=OneWay}"
                Value="{x:Bind ViewModel.CurrentPosition, Mode=OneWay}" />

            <Grid Margin="0,4,0,0">
                <TextBlock
                    HorizontalAlignment="Left"
                    Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                    Style="{ThemeResource CaptionTextBlockStyle}"
                    Text="{x:Bind ViewModel.FormattedPosition, Mode=OneWay}" />
                <TextBlock
                    HorizontalAlignment="Right"
                    Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                    Style="{ThemeResource CaptionTextBlockStyle}"
                    Text="{x:Bind ViewModel.FormattedDuration, Mode=OneWay}" />
            </Grid>

            <StackPanel
                Margin="0,16,0,0"
                HorizontalAlignment="Center"
                Orientation="Horizontal"
                Spacing="16">
                <Button
                    Width="48"
                    Height="48"
                    Command="{x:Bind ViewModel.PreviousCommand}"
                    CornerRadius="24">
                    <FontIcon FontFamily="Segoe Fluent Icons" Glyph="&#xE892;" />
                </Button>
                <Button
                    Width="64"
                    Height="64"
                    Command="{x:Bind ViewModel.PlayPauseCommand}"
                    CornerRadius="32"
                    Style="{ThemeResource AccentButtonStyle}">
                    <FontIcon
                        FontFamily="Segoe Fluent Icons"
                        FontSize="24"
                        Glyph="{x:Bind ViewModel.PlayPauseIcon, Mode=OneWay}" />
                </Button>
                <Button
                    Width="48"
                    Height="48"
                    Command="{x:Bind ViewModel.NextCommand}"
                    CornerRadius="24">
                    <FontIcon FontFamily="Segoe Fluent Icons" Glyph="&#xE893;" />
                </Button>
            </StackPanel>
        </StackPanel>
    </Grid>
</Page>
