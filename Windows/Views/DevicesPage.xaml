<Page
    x:Class="WindowsMediaReceiver.Views.DevicesPage"
    x:Name="RootPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:models="using:WindowsMediaReceiver.Models"
    mc:Ignorable="d"
    Background="Transparent">

    <Page.Resources>
        <local:StatusToColorConverter x:Key="StatusToColorConverter" xmlns:local="using:WindowsMediaReceiver.Views" />
    </Page.Resources>

    <Grid>
        <StackPanel Spacing="16">
            <TextBlock Text="Connected Device" Style="{ThemeResource TitleTextBlockStyle}" FontWeight="SemiBold" />
            <TextBlock Text="Manage the currently connected device here" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />

            <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" Spacing="8" Margin="0,48,0,0" Visibility="{x:Bind ViewModel.NoDeviceVisibility, Mode=OneWay}">
                <FontIcon Glyph="&#xE7F4;" FontSize="14" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                <TextBlock Text="Waiting for connection..." Foreground="{ThemeResource TextFillColorSecondaryBrush}" Style="{ThemeResource CaptionTextBlockStyle}" />
            </StackPanel>

            <ContentControl Content="{x:Bind ViewModel.CurrentDevice, Mode=OneWay}">
                <ContentControl.ContentTemplate>
                    <DataTemplate x:DataType="models:DeviceModel">
                        <Grid Margin="0,8,0,8" Padding="16" Background="{ThemeResource CardBackgroundFillColorDefaultBrush}" CornerRadius="8" BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}" BorderThickness="1">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            
                            <FontIcon Glyph="&#xE8EA;" FontSize="24" VerticalAlignment="Center" Margin="0,0,16,0" Foreground="{ThemeResource AccentTextFillColorPrimaryBrush}" />
                            
                            <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                <TextBlock Text="{x:Bind DeviceName, Mode=OneWay}" FontWeight="SemiBold" Style="{ThemeResource BodyStrongTextBlockStyle}" />
                                <StackPanel Orientation="Horizontal" Spacing="8" Margin="0,4,0,0">
                                    <TextBlock Text="{x:Bind DeviceType, Mode=OneWay}" Foreground="{ThemeResource TextFillColorSecondaryBrush}" Style="{ThemeResource CaptionTextBlockStyle}" />
                                    <TextBlock Text="•" Foreground="{ThemeResource TextFillColorSecondaryBrush}" Style="{ThemeResource CaptionTextBlockStyle}" />
                                    <TextBlock Text="{x:Bind OsVersion, Mode=OneWay}" Foreground="{ThemeResource TextFillColorSecondaryBrush}" Style="{ThemeResource CaptionTextBlockStyle}" />
                                    <TextBlock Text="•" Foreground="{ThemeResource TextFillColorSecondaryBrush}" Style="{ThemeResource CaptionTextBlockStyle}" />
                                    <TextBlock Text="{x:Bind IPAddress, Mode=OneWay}" Foreground="{ThemeResource TextFillColorSecondaryBrush}" Style="{ThemeResource CaptionTextBlockStyle}" />
                                </StackPanel>
                            </StackPanel>

                            <Button Grid.Column="2" VerticalAlignment="Center" HorizontalAlignment="Right" Command="{Binding ElementName=RootPage, Path=ViewModel.DisconnectCommand}" Foreground="{ThemeResource SystemFillColorCriticalBrush}" Style="{ThemeResource DateTimePickerFlyoutButtonStyle}">
                                <StackPanel Orientation="Horizontal" Spacing="8">
                                    <FontIcon Glyph="&#xE8BB;" FontSize="12" />
                                    <TextBlock Text="Disconnect" FontSize="12" />
                                </StackPanel>
                            </Button>
                        </Grid>
                    </DataTemplate>
                </ContentControl.ContentTemplate>
            </ContentControl>
        </StackPanel>
    </Grid>
</Page>
