<Page
    x:Class="CarpeCast.Views.DevicesPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:models="using:CarpeCast.Models"
    x:Name="RootPage"
    Background="Transparent"
    mc:Ignorable="d">

    <Page.Resources>
        <local:StatusToColorConverter xmlns:local="using:CarpeCast.Views" x:Key="StatusToColorConverter" />
        <local:BoolToVisibilityConverter xmlns:local="using:CarpeCast.Views" x:Key="BoolToVis" />
        <local:InverseBoolToVisibilityConverter xmlns:local="using:CarpeCast.Views" x:Key="InverseBoolToVis" />
    </Page.Resources>

    <ScrollViewer Padding="36,0" VerticalScrollBarVisibility="Auto">
        <StackPanel Margin="0,36" Spacing="4">
            <TextBlock
                x:Uid="DevicesTitle"
                FontWeight="SemiBold"
                Style="{ThemeResource TitleTextBlockStyle}"
                Text="Discovered Devices" />
            <TextBlock
                x:Uid="DevicesDescription"
                Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                Text="Manage the devices on your local network here" />

            <StackPanel
                Margin="0,64,0,0"
                HorizontalAlignment="Center"
                Orientation="Vertical"
                Spacing="16"
                Visibility="{x:Bind ViewModel.NoDeviceVisibility, Mode=OneWay}">
                <ProgressRing IsActive="True" Margin="0,0,0,16" />
                <TextBlock
                    x:Uid="DevicesWaiting"
                    Foreground="{ThemeResource TextFillColorDisabledBrush}"
                    Style="{ThemeResource BodyTextBlockStyle}"
                    Text="Searching for devices..." />
            </StackPanel>

            <ItemsControl Margin="0,24,0,0" ItemsSource="{x:Bind ViewModel.Devices, Mode=OneWay}">
                <ItemsControl.ItemTemplate>
                    <DataTemplate x:DataType="models:DeviceModel">
                        <Grid
                            Padding="16"
                            Margin="0,0,0,8"
                            Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                            BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                            BorderThickness="1"
                            ColumnSpacing="16"
                            CornerRadius="4">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>

                            <FontIcon
                                VerticalAlignment="Center"
                                FontSize="24"
                                Foreground="{ThemeResource AccentTextFillColorPrimaryBrush}"
                                Glyph="{x:Bind IconGlyph, Mode=OneWay}" />

                            <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                <TextBlock
                                    FontWeight="SemiBold"
                                    Style="{ThemeResource BodyStrongTextBlockStyle}"
                                    Text="{x:Bind DeviceName, Mode=OneWay}" />
                                <StackPanel
                                    Margin="0,4,0,0"
                                    Orientation="Horizontal"
                                    Spacing="8">
                                    <TextBlock
                                        Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                        Style="{ThemeResource CaptionTextBlockStyle}"
                                        Text="{x:Bind DeviceType, Mode=OneWay}" />
                                    <TextBlock
                                        Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                        Style="{ThemeResource CaptionTextBlockStyle}"
                                        Text="•" />
                                    <TextBlock
                                        Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                        Style="{ThemeResource CaptionTextBlockStyle}"
                                        Text="{x:Bind OsVersion, Mode=OneWay}" />
                                    <TextBlock
                                        Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                        Style="{ThemeResource CaptionTextBlockStyle}"
                                        Text="•" />
                                    <TextBlock
                                        Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                        Style="{ThemeResource CaptionTextBlockStyle}"
                                        Text="{x:Bind IPAddress, Mode=OneWay}" />
                                </StackPanel>
                            </StackPanel>

                            <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center">
                                <Button
                                    Visibility="{x:Bind IsConnected, Mode=OneWay, Converter={StaticResource BoolToVis}}"
                                    Command="{Binding ElementName=RootPage, Path=ViewModel.DisconnectDeviceCommand}"
                                    CommandParameter="{x:Bind}"
                                    Style="{ThemeResource AccentButtonStyle}">
                                    <StackPanel Orientation="Horizontal" Spacing="8">
                                        <TextBlock
                                            x:Uid="DevicesDisconnect"
                                            FontSize="12"
                                            Text="Disconnect" />
                                    </StackPanel>
                                </Button>

                                <Button
                                    Visibility="{x:Bind IsConnected, Mode=OneWay, Converter={StaticResource InverseBoolToVis}}"
                                    Command="{Binding ElementName=RootPage, Path=ViewModel.ConnectToSenderCommand}"
                                    CommandParameter="{x:Bind}">
                                    <StackPanel Orientation="Horizontal" Spacing="8">
                                        <TextBlock
                                            x:Uid="DevicesConnect"
                                            FontSize="12"
                                            Text="Connect" />
                                    </StackPanel>
                                </Button>
                            </StackPanel>
                        </Grid>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>
        </StackPanel>
    </ScrollViewer>
</Page>

