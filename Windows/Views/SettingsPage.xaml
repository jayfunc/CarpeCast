<Page
    x:Class="CarpeCast.Views.SettingsPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:tk="using:CommunityToolkit.WinUI.Controls"
    xmlns:viewmodels="using:CarpeCast.ViewModels"
    Background="Transparent"
    mc:Ignorable="d">

    <ScrollViewer Padding="36,0" VerticalScrollBarVisibility="Auto">
        <StackPanel Margin="0,36">
            <TextBlock
                x:Uid="SettingsTitle"
                Margin="0,0,0,16"
                Style="{ThemeResource TitleTextBlockStyle}"
                Text="Settings" />

            <StackPanel
                Margin="0,0,0,32"
                HorizontalAlignment="Center"
                Spacing="8">
                <Border
                    Width="80"
                    Height="80"
                    CornerRadius="12">
                    <Image Source="/Assets/Square150x150Logo.scale-200.png" />
                </Border>
                <TextBlock
                    HorizontalAlignment="Center"
                    Style="{ThemeResource SubtitleTextBlockStyle}"
                    Text="CarpeCast" />
                <TextBlock
                    HorizontalAlignment="Center"
                    Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                    Style="{ThemeResource CaptionTextBlockStyle}">
                    <Run Text="{x:Bind ViewModel.VersionPrefix}" />
                    <Hyperlink NavigateUri="{x:Bind ViewModel.CommitUri}">
                        <Run Text="{x:Bind ViewModel.CommitHash}" />
                    </Hyperlink>
                    <Run Text=")" />
                </TextBlock>
            </StackPanel>

            <InfoBar
                x:Uid="RestartPromptInfoBar"
                Title="Restart Required"
                Margin="0,0,0,16"
                IsClosable="False"
                IsOpen="{x:Bind ViewModel.IsRestartRequired, Mode=OneWay}"
                Message="Some changes require restarting the app to take effect."
                Severity="Warning">
                <InfoBar.ActionButton>
                    <Button
                        x:Uid="RestartNowBtn"
                        Command="{x:Bind ViewModel.SaveAndRestartCommand}"
                        Content="Restart Now" />
                </InfoBar.ActionButton>
            </InfoBar>

            <tk:SettingsCard x:Uid="DeviceNameCard">
                <tk:SettingsCard.HeaderIcon>
                    <FontIcon FontFamily="Segoe Fluent Icons" Glyph="&#xE975;" />
                </tk:SettingsCard.HeaderIcon>
                <tk:SettingsCard.Header>
                    <TextBlock x:Uid="DeviceNameLabel" Text="Device Name" />
                </tk:SettingsCard.Header>
                <StackPanel Orientation="Horizontal" Spacing="8">
                    <TextBox Width="200" Text="{x:Bind ViewModel.DeviceName, Mode=TwoWay}" />
                    <Button
                        x:Uid="RestoreDefaultBtn"
                        Command="{x:Bind ViewModel.RestoreDefaultNameCommand}"
                        Content="Restore Default" />
                </StackPanel>
            </tk:SettingsCard>

            <tk:SettingsExpander x:Uid="NetworkPortsExpander">
                <tk:SettingsExpander.HeaderIcon>
                    <FontIcon FontFamily="Segoe Fluent Icons" Glyph="&#xE839;" />
                </tk:SettingsExpander.HeaderIcon>
                <tk:SettingsExpander.Header>
                    <TextBlock x:Uid="NetworkPortsLabel" Text="Network Ports" />
                </tk:SettingsExpander.Header>
                <tk:SettingsExpander.Items>
                    <tk:SettingsCard x:Uid="DiscoveryPortCard">
                        <tk:SettingsCard.Header>
                            <TextBlock x:Uid="DiscoveryPortLabel" Text="Discovery Port" />
                        </tk:SettingsCard.Header>
                        <NumberBox
                            Width="100"
                            SpinButtonPlacementMode="Hidden"
                            Value="{x:Bind ViewModel.DiscoveryPort, Mode=TwoWay}" />
                    </tk:SettingsCard>
                    <tk:SettingsCard x:Uid="DataPortCard">
                        <tk:SettingsCard.Header>
                            <TextBlock x:Uid="DataPortLabel" Text="Data Port" />
                        </tk:SettingsCard.Header>
                        <NumberBox
                            Width="100"
                            SpinButtonPlacementMode="Hidden"
                            Value="{x:Bind ViewModel.DataPort, Mode=TwoWay}" />
                    </tk:SettingsCard>
                </tk:SettingsExpander.Items>
            </tk:SettingsExpander>



            <tk:SettingsCard>
                <tk:SettingsCard.HeaderIcon>
                    <FontIcon FontFamily="Segoe Fluent Icons" Glyph="&#xE790;" />
                </tk:SettingsCard.HeaderIcon>
                <tk:SettingsCard.Header>
                    <TextBlock x:Uid="ThemeLabel" Text="Theme" />
                </tk:SettingsCard.Header>
                <ComboBox Width="150" SelectedIndex="{x:Bind ViewModel.SelectedThemeIndex, Mode=TwoWay}">
                    <ComboBoxItem
                        x:Uid="ThemeSystem"
                        Content="System"
                        Tag="System" />
                    <ComboBoxItem
                        x:Uid="ThemeLight"
                        Content="Light"
                        Tag="Light" />
                    <ComboBoxItem
                        x:Uid="ThemeDark"
                        Content="Dark"
                        Tag="Dark" />
                </ComboBox>
            </tk:SettingsCard>

            <tk:SettingsCard x:Uid="LanguageCard">
                <tk:SettingsCard.HeaderIcon>
                    <FontIcon FontFamily="Segoe Fluent Icons" Glyph="&#xE774;" />
                </tk:SettingsCard.HeaderIcon>
                <tk:SettingsCard.Header>
                    <TextBlock x:Uid="LanguageLabel" Text="Language" />
                </tk:SettingsCard.Header>
                <ComboBox Width="150" SelectedIndex="{x:Bind ViewModel.SelectedLanguageIndex, Mode=TwoWay}">
                    <ComboBoxItem Content="English" Tag="en-US" />
                    <ComboBoxItem Content="中文" Tag="zh-CN" />
                </ComboBox>
            </tk:SettingsCard>

            <tk:SettingsCard x:Uid="ShowOnStartupCard">
                <tk:SettingsCard.HeaderIcon>
                    <FontIcon FontFamily="Segoe Fluent Icons" Glyph="&#xE7E8;" />
                </tk:SettingsCard.HeaderIcon>
                <tk:SettingsCard.Header>
                    <TextBlock x:Uid="ShowOnStartupLabel" Text="Show main window on startup" />
                </tk:SettingsCard.Header>
                <ToggleSwitch IsOn="{x:Bind ViewModel.ShowOnStartup, Mode=TwoWay}" />
            </tk:SettingsCard>

            <tk:SettingsCard
                x:Uid="SystemStartupCard"
                Command="{x:Bind ViewModel.OpenStartupSettingsCommand}"
                IsClickEnabled="True">
                <tk:SettingsCard.HeaderIcon>
                    <FontIcon FontFamily="Segoe Fluent Icons" Glyph="&#xE713;" />
                </tk:SettingsCard.HeaderIcon>
                <tk:SettingsCard.Header>
                    <TextBlock x:Uid="SystemStartupLabel" Text="Open Windows Startup Settings" />
                </tk:SettingsCard.Header>
                <tk:SettingsCard.Description>
                    <TextBlock x:Uid="SystemStartupDesc" Text="Configure whether CarpeCast launches automatically when you log in to Windows." />
                </tk:SettingsCard.Description>
                <FontIcon
                    FontFamily="Segoe Fluent Icons"
                    FontSize="14"
                    Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                    Glyph="&#xE8A7;" />
            </tk:SettingsCard>

            <tk:SettingsCard
                x:Uid="DownloadAndroidCard"
                Command="{x:Bind ViewModel.DownloadAndroidCommand}"
                IsClickEnabled="True">
                <tk:SettingsCard.Header>
                    <Grid>
                        <Grid HorizontalAlignment="Left" VerticalAlignment="Top">
                            <Grid.RenderTransform>
                                <TranslateTransform X="0" Y="8" />
                            </Grid.RenderTransform>
                            <Image
                                Width="22"
                                Height="22"
                                Source="/Assets/Square150x150Logo.scale-200.png" />
                            <Image
                                Width="14"
                                Height="14"
                                HorizontalAlignment="Right"
                                VerticalAlignment="Bottom"
                                Source="/Assets/android-logo.svg">
                                <Image.RenderTransform>
                                    <TranslateTransform X="4" Y="4" />
                                </Image.RenderTransform>
                            </Image>
                        </Grid>
                        <TextBlock
                            x:Uid="DownloadAndroidTitle"
                            Margin="42,0,0,0"
                            Text="CarpeCast for Android" />
                    </Grid>
                </tk:SettingsCard.Header>
                <tk:SettingsCard.Description>
                    <TextBlock
                        x:Uid="DownloadAndroidDesc"
                        Margin="42,0,0,0"
                        Text="Get the Android app to sync playback with your phone." />
                </tk:SettingsCard.Description>
                <FontIcon
                    FontFamily="Segoe Fluent Icons"
                    FontSize="14"
                    Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                    Glyph="&#xE8A7;" />
            </tk:SettingsCard>

            <tk:SettingsCard
                x:Uid="AboutBetterLyricsCard"
                Command="{x:Bind ViewModel.OpenBetterLyricsCommand}"
                IsClickEnabled="True">
                <tk:SettingsCard.HeaderIcon>
                    <ImageIcon Source="/Assets/BetterLyricsLogo.png" />
                </tk:SettingsCard.HeaderIcon>
                <tk:SettingsCard.Header>
                    <TextBlock x:Uid="AboutBetterLyricsTitle" Text="BetterLyrics" />
                </tk:SettingsCard.Header>
                <tk:SettingsCard.Description>
                    <TextBlock x:Uid="AboutBetterLyricsDesc" Text="For the best desktop lyric experience, try BetterLyrics." />
                </tk:SettingsCard.Description>
                <FontIcon
                    FontFamily="Segoe Fluent Icons"
                    FontSize="14"
                    Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                    Glyph="&#xE8A7;" />
            </tk:SettingsCard>
        </StackPanel>
    </ScrollViewer>
</Page>
