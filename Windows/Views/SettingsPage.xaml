<Page
    x:Class="WindowsMediaReceiver.Views.SettingsPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:tk="using:CommunityToolkit.WinUI.Controls"
    xmlns:viewmodels="using:WindowsMediaReceiver.ViewModels"
    mc:Ignorable="d"
    Background="Transparent">

    <ScrollViewer VerticalScrollBarVisibility="Auto" Margin="0,0,16,0">
        <StackPanel MaxWidth="800" HorizontalAlignment="Stretch" Spacing="4">
            <TextBlock x:Uid="SettingsTitle" Text="Settings" Style="{ThemeResource TitleTextBlockStyle}" Margin="0,0,0,16" />
            
            <tk:SettingsCard x:Uid="DeviceNameCard">
                <tk:SettingsCard.HeaderIcon>
                    <FontIcon FontFamily="Segoe Fluent Icons" Glyph="&#xE975;" />
                </tk:SettingsCard.HeaderIcon>
                <tk:SettingsCard.Header>
                    <TextBlock x:Uid="DeviceNameLabel" Text="Device Name"/>
                </tk:SettingsCard.Header>
                <TextBox Text="{x:Bind ViewModel.DeviceName, Mode=TwoWay}" Width="200" />
            </tk:SettingsCard>

            <tk:SettingsExpander x:Uid="NetworkPortsExpander">
                <tk:SettingsExpander.HeaderIcon>
                    <FontIcon FontFamily="Segoe Fluent Icons" Glyph="&#xE839;" />
                </tk:SettingsExpander.HeaderIcon>
                <tk:SettingsExpander.Header>
                    <TextBlock x:Uid="NetworkPortsLabel" Text="Network Ports"/>
                </tk:SettingsExpander.Header>
                <tk:SettingsExpander.Items>
                    <tk:SettingsCard x:Uid="DiscoveryPortCard">
                        <tk:SettingsCard.Header>
                            <TextBlock x:Uid="DiscoveryPortLabel" Text="Discovery Port"/>
                        </tk:SettingsCard.Header>
                        <NumberBox Value="{x:Bind ViewModel.DiscoveryPort, Mode=TwoWay}" SpinButtonPlacementMode="Hidden" Width="100"/>
                    </tk:SettingsCard>
                    <tk:SettingsCard x:Uid="DataPortCard">
                        <tk:SettingsCard.Header>
                            <TextBlock x:Uid="DataPortLabel" Text="Data Port"/>
                        </tk:SettingsCard.Header>
                        <NumberBox Value="{x:Bind ViewModel.DataPort, Mode=TwoWay}" SpinButtonPlacementMode="Hidden" Width="100"/>
                    </tk:SettingsCard>
                </tk:SettingsExpander.Items>
            </tk:SettingsExpander>

            <Button x:Uid="SaveSettingsBtn" Content="Save &amp; Restart" Command="{x:Bind ViewModel.SaveAndRestartCommand}" HorizontalAlignment="Right" Margin="0,12,0,24" Style="{ThemeResource AccentButtonStyle}" />

            <tk:SettingsCard>
                <tk:SettingsCard.HeaderIcon>
                    <FontIcon FontFamily="Segoe Fluent Icons" Glyph="&#xE790;" />
                </tk:SettingsCard.HeaderIcon>
                <tk:SettingsCard.Header>
                    <TextBlock x:Uid="ThemeLabel" Text="Theme"/>
                </tk:SettingsCard.Header>
                <ComboBox SelectedIndex="{x:Bind ViewModel.SelectedThemeIndex, Mode=TwoWay}" Width="150">
                    <ComboBoxItem x:Uid="ThemeSystem" Content="System" Tag="System"/>
                    <ComboBoxItem x:Uid="ThemeLight" Content="Light" Tag="Light"/>
                    <ComboBoxItem x:Uid="ThemeDark" Content="Dark" Tag="Dark"/>
                </ComboBox>
            </tk:SettingsCard>

            <tk:SettingsCard x:Uid="LanguageCard">
                <tk:SettingsCard.HeaderIcon>
                    <FontIcon FontFamily="Segoe Fluent Icons" Glyph="&#xE774;" />
                </tk:SettingsCard.HeaderIcon>
                <tk:SettingsCard.Header>
                    <TextBlock x:Uid="LanguageLabel" Text="Language"/>
                </tk:SettingsCard.Header>
                <ComboBox SelectedIndex="{x:Bind ViewModel.SelectedLanguageIndex, Mode=TwoWay}" Width="150">
                    <ComboBoxItem Content="English" Tag="en-US"/>
                    <ComboBoxItem Content="中文" Tag="zh-CN"/>
                </ComboBox>
            </tk:SettingsCard>
        </StackPanel>
    </ScrollViewer>
</Page>
